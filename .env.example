# Public site origin (no trailing slash). Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://www.skillstand-in.com

# Public contact address shown in the footer and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=ceo@skillstand-in.com

# Resend (https://resend.com). When unset, form submissions are logged to the
# server console so the full flow is testable locally.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ceo@skillstand-in.com
# Optional override. Defaults to Resend's onboarding sender in development.
CONTACT_FROM_EMAIL=Skill Stand In <onboarding@resend.dev>

# Cloudflare Turnstile. When either key is unset, the widget is skipped on the
# client and verification is skipped on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
